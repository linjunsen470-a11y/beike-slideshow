# Optional image editing only. Beike credentials never belong in this file.
# Gemini defaults to economy (Flash Lite Image), 1K, minimal thinking.
IMAGE_EDIT_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent
IMAGE_EDIT_MODEL=gemini-3.1-flash-lite-image
IMAGE_EDIT_API_KEY=

# For OpenAI-compatible editing, set an HTTPS /v1/images/edits endpoint
# and its image model. The Gemini economy default does not override that model.
# Use --model configured to explicitly honor IMAGE_EDIT_MODEL for Gemini.
